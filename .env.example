# FORMA Environment Configuration Template
# Copy this file to .env and configure your keys

# Optional: Global Gemini API Key (Users can also provide their own key in-app via Settings)
# GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Can also be managed via FlutterFire CLI)
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_PROJECT_ID=forma-fitness-tracker
